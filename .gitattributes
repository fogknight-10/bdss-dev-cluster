# Files that run inside Linux containers must keep Unix (LF) line endings,
# even when checked out on Windows, otherwise bash fails with "\r: command not found".
*.sh          text eol=lf
*.env         text eol=lf
.env*         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.py          text eol=lf
*.md          text eol=lf
*.json        text eol=lf
Dockerfile    text eol=lf
*.txt         text eol=lf

# Sample datasets are left exactly as downloaded.
data/**       -text
*.jar         binary
*.class       binary
