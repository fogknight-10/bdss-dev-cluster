# =============================================================================
#  BDSS Dev Cluster - settings (copy to .env; every value has a default)
#  https://github.com/fogknight-10/bdss-dev-cluster
#  Dev-only configuration. Nothing here is a secret.
# =============================================================================

# --- identity ---------------------------------------------------------------
STACK_NAME=bdss              # prefix of every container name (bdss-master1, bdss-dev, ...)
AUTHOR_NAME=Mohamed          # shown in the dev container banner and image labels

# --- HDFS -------------------------------------------------------------------
HADOOP_USER_NAME=user        # HDFS identity of the dev/init containers: must be the owner of /user in HDFS (the cluster's HDFS user is 'user'; 'root' is denied)
HADOOP_TMP_DIR=/tmp/hadoop-user     # hadoop.tmp.dir of the workers' user: the DataNodes store blocks in <this>/dfs/data (confirmed on worker1)
HDFS_SYNC_ON_START=false     # true = the init container mirrors ./data into hdfs:///data on every start

# --- host ports (change one if another program already uses it) --------------
NN1_UI_PORT=19870            # HDFS NameNode UI (master1)
NN2_UI_PORT=29870            # HDFS NameNode UI (master2)
RM1_UI_PORT=18088            # YARN ResourceManager UI (master1)
RM2_UI_PORT=28088            # YARN ResourceManager UI (master2)
JN1_PORT=18480               # JournalNode 1 UI
JN2_PORT=28480               # JournalNode 2 UI
JN3_PORT=38480               # JournalNode 3 UI
HIVE_UI_PORT=10002           # HiveServer2 UI
SPARK_HISTORY_PORT=18080     # Spark History Server (worker4)
JUPYTER_PORT=8000            # JupyterLab on worker4 (original cluster)
SPARK_APP_UI_PORT=4040       # Spark application UI of the worker4 driver
ZK_PORT=2181                 # ZooKeeper
METASTORE_DB_PORT=6432       # PostgreSQL (Hive metastore)
KAFKA_PORT=9092              # Kafka (advertised as kafka:9092 - reachable from containers only)
DEV_JUPYTER_PORT=8888        # optional JupyterLab inside the dev container
DEV_SPARK_UI_PORT=4050       # Spark application UI of the dev container driver
